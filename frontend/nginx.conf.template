# Rendered by the nginx image's entrypoint via envsubst, which only replaces
# variables that are actually set in the environment. nginx's own $variables
# ($uri, $host, ...) are not environment variables and are left untouched.
#
# BACKEND_UPSTREAM:
#   docker-compose -> campusshield-backend:8000 (the Compose DNS name)
#   ECS/Fargate     -> localhost. The ALB listener rule sends /api/* straight
#                      to the backend target group, so this location is never
#                      reached in production; the value only has to be
#                      syntactically valid so nginx can start.
server {
    listen 8080;
    server_name localhost;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # Serve static files
    location / {
        root /usr/share/nginx/html;
        index index.html;

        # SPA routing: try to serve the file, if not found, serve index.html
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to backend. Unused behind the ALB - see header.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
