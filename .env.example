# ---- Backend (read by FastAPI via pydantic-settings) -------------------------
# GEMINI_API_KEY may be left EMPTY. The app still starts and analysis falls
# back to the deterministic classifier. Paste a real key from
# https://aistudio.google.com/apikey to enable Gemini analysis.
# Never commit a real key - .env is gitignored, this .env.example is not.
DATABASE_URL=postgresql://campusshield:campusshield@postgres:5432/campusshield
SECRET_KEY=super-secret-key-for-dev-only-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Frontend (baked into the bundle at BUILD time) --------------------------
# Because Vite inlines import.meta.env, anything prefixed VITE_ becomes PUBLIC.
# Never put GEMINI_API_KEY or any secret here - it would ship to every browser.
VITE_API_URL=/api/v1
