# ---- Required before AI features work ---------------------------------------
# Leave EMPTY to run the app. It will start fine and complaint analysis will
# use the deterministic fallback classifier instead of Gemini.
#
# To enable real Gemini analysis, create a key at
#   https://aistudio.google.com/apikey
# and paste it below. Never commit a real key - .env is gitignored, this
# .env.example is not.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Required in every environment ------------------------------------------
DATABASE_URL=postgresql://campusshield:campusshield@postgres:5432/campusshield
SECRET_KEY=changeme-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Optional tuning ---------------------------------------------------------
UPLOAD_DIR=uploads
S3_BUCKET=
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
SEED_DEMO_USERS=true
